{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "baseUrl": "./",
    "paths": {
      "@core/*": ["CORE/*"],
      "@plugins/*": ["plugins/*"],
      "@commands/*": ["commands/*"]
      "@aurora/styler": ["plugins/aurora-styler"]
      }
    },
    "typeRoots": ["./node_modules/@types", "./CORE"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["CORE/**/*", "commands/**/*", "plugins/**/*", "index.js"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    "transpileOnly": true,
    "files": true
  }
}
